        {
          "_uid": "e6c8bf9b-286a-48ef-b438-4ce9cac79062",
          "faqs": [
            {
              "_uid": "bfceca86-7cd7-4950-ab18-008101b9987c",
              "text": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Every plan includes Voice and video functionality with Pro and Custom plans including free voice and video minutes. ",
                        "type": "text"
                      },
                      { "type": "hard_break" },
                      { "type": "hard_break" },
                      {
                        "text": "Pro customers get 15k voice and video minutes per month; Custom plan customers get 50k voice and video minutes per month. Minutes are split equally between voice and video regardless of plan. Essential plans do not include free voice and video minutes.",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              "title": "Is voice and video calling included?",
              "component": "faq"
            },
            {
              "_uid": "245b8566-8ff5-4af2-83d5-b2b151a8c730",
              "text": "Yes! Our chat is HIPAA compliant. In every case HIPAA requires a Business Associate Agreement (BAA). In the Essentials and Pro plans it’s a paid add-on. In the Custom plan BAA is an included add-on. Please reach out to get one set up.",
              "title": "Do you offer HIPAA compliance?",
              "component": "faq"
            },
            {
              "_uid": "334b0318-debd-4fd3-a1ee-123113a81664",
              "text": "A Monthly Active User (MAU) is a user that has connected to CometChat servers during the 30 day subscription period.",
              "title": "What are Monthly Active Users?",
              "component": "faq"
            },
            {
              "_uid": "48aa8255-2637-4be6-820a-d74a0d5ece87",
              "text": "The maximum number of devices connected to CometChat at the same time. Note that this is the number of devices connected, not users. One user may be connected via two devices, which results in two concurrent connections.",
              "title": "What are Peak Concurrent Connections (PCCs)?",
              "component": "faq"
            },
            {
              "_uid": "3c8bb183-76bf-4563-8a50-317c8f595e25",
              "text": "All plans include 5% Peak Concurrent Connections (PCC). For single-tenant subscriptions, this is calculated as the maximum number of connections to CometChat at any given time. For example, if your plan includes 10,000 MAU, 500 devices can be connected to CometChat at the same time. Beyond 5%, overages fees will apply.",
              "title": "How many Peak Concurrent Connections are included?",
              "component": "faq"
            },
            {
              "_uid": "31d909c8-489e-4548-a76d-c6383b05d2c3",
              "text": "If you exceed your MAUs, Voice and Video Minutes, or Peak Concurrent Connections (PCC) limits, you will be automatically charged an overage fee. For up to 50K MAUs, you'll be charged $0.12 per MAU. Similarly for Video calls, $0.003 /min. per user, and $0.001 /min. per user for Voice call minutes. For every PCC you'll be charged $1.\nContact us if you have further queries.",
              "title": "What happens if I exceed my plan’s limits?",
              "component": "faq"
            },
            {
              "_uid": "6e957b47-500c-4f40-8d58-3ec3dbcbe4b9",
              "text": "Yes we do. Some of our notable customers who use CometChat for a multi-tenant use case are Kahoot, Vaave, Entole, Gosource, etc. For such subscriptions, PCC is measured by individual app and aggregated to the day level and the highest day during the subscription month is used.",
              "title": "Do you offer multi-tenancy features?",
              "component": "faq"
            },
            {
