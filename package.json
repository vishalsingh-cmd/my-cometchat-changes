{
  "name": "cometchat-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "dev": "vite dev",
    "dev:host": "vite dev --host",
    "prebuild": "npm run datasources",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "vitest run",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "compress-icons": "npx svgo --config=svgo.config.cjs --input=src/components/icon/assets --output=src/components/icon/assets",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "sb:login": "npx storyblok@latest logout && npx storyblok login",
    "sb:pull": "npx storyblok@latest pull-components --space=231922",
    "sb:types": "storyblok-generate-ts source=./components.231922.json target=./src/types/bloks.d.ts && prettier ./src/types/bloks.d.ts --write",
    "sb": "npm run sb:pull && npm run sb:types",
    "datasources": "svelte-kit sync && npx ts-node@latest --project ./node.tsconfig.json ./scripts/datasources.ts"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.0.18",
    "@storybook/addon-interactions": "^7.0.18",
    "@storybook/addon-links": "^7.0.18",
    "@storybook/blocks": "^7.0.18",
    "@storybook/svelte": "^7.0.18",
    "@storybook/sveltekit": "^7.0.18",
    "@storybook/testing-library": "^0.0.14-next.2",
    "@sveltejs/adapter-auto": "^2.0.0",
    "@sveltejs/kit": "^1.5.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "autoprefixer": "^10.4.14",
    "class-variance-authority": "^0.6.0",
    "clsx": "^1.2.1",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-storybook": "^0.6.12",
    "eslint-plugin-svelte": "^2.26.0",
    "husky": "^8.0.0",
    "postcss": "^8.4.23",
    "prettier": "^2.8.0",
    "prettier-plugin-svelte": "^2.8.1",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storyblok-generate-ts": "^1.14.0",
    "storybook": "^7.0.18",
    "svelte": "^3.54.0",
    "svelte-check": "^3.0.1",
    "tailwind-merge": "^1.12.0",
    "tailwindcss": "^3.3.2",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^4.3.0",
    "vite-plugin-mkcert": "^1.15.0",
    "vitest": "^0.25.3"
  },
  "type": "module",
  "dependencies": {
    "@types/prismjs": "^1.26.0",
    "prism-svelte": "^0.5.0",
    "prismjs": "^1.29.0",
    "@storyblok/js": "^2.1.6",
    "date-fns": "^2.30.0"
  }
}
